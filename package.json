{
  "name": "sites-project",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "dev:sites": "vinext dev",
    "build:sites": "vinext build",
    "start:sites": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "test:a11y": "node scripts/a11y-audit.mjs",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "research:validate": "PYTHONPATH=research/src python3 -m aiio.cli --root . validate-registry",
    "research:test": "PYTHONPATH=research/src python3 -m unittest discover -s research/tests -v",
    "labour:normalize": "PYTHONPATH=research/src python3 -m aiio.cli --root . normalize-jvws data/raw/statcan_jvws_14100444/2026-08-31_38a420036ad5.zip",
    "labour:normalize:canada": "PYTHONPATH=research/src python3 -m aiio.cli --root . normalize-jvws-canada data/raw/statcan_jvws_14100444/2026-08-31_38a420036ad5.zip",
    "digest:build": "PYTHONPATH=research/src python3 -m aiio.cli --root . build-digest data/digests/items/2026-08-31.json --date 2026-08-31",
    "model:run": "PYTHONPATH=research/src python3 -m aiio.cli --root . run-scenario data/model/alberta_graph_v0.2.json data/scenarios/alberta_50b_counterfactual_v0.2.json data/model-runs/alberta_50b_counterfactual_v0.2.json",
    "power:run": "PYTHONPATH=research/src python3 -m aiio.cli --root . run-power-overlay data/scenarios/alberta_power_overlay_v0.1.json data/model-runs/alberta_power_overlay_v0.1.json",
    "workbook:build": "node workbook-work/build_aiio_workbook.mjs",
    "release:build": "PYTHONPATH=research/src python3 -m aiio.cli --root . build-release 0.4.0-dev --created-at 2026-08-31T20:30:00Z",
    "release:verify": "PYTHONPATH=research/src python3 -m aiio.cli --root . verify-release 0.4.0-dev",
    "publication:build": "PYTHONPATH=research/src python3 -m aiio.cli --root . build-publication-artifacts 0.4.0-dev outputs/01a0579f-936b-77b3-93e5-be6035628b16/AIIO_Alberta_Pilot_0.4.0-dev.xlsx"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "^19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "^1.0.0-beta.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.54.2",
    "@cloudflare/workers-types": "^5.20260831.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright-core": "^1.62.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  },
  "type": "module"
}
