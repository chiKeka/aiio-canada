{
  "schema_version": "1.0.0",
  "contract_id": "AIIO_E2_ATTRIBUTION_PANEL_CONTRACT_0_1",
  "estimand_id": "E2_AI_ATTRIBUTABLE_INCREMENT",
  "estimand": "Difference between a public-project outcome under observed regional AI-infrastructure construction exposure and the otherwise-equivalent outcome without that exposure.",
  "unit_of_analysis": "region_quarter_asset_class",
  "geography_level": "census_metropolitan_area_or_reconciled_electricity_planning_region",
  "frequency": "quarterly",
  "design": {
    "primary_estimator": "staggered_group_time_average_treatment_effect",
    "control_cohort": "not_yet_treated_or_never_treated_regions_with_common_support",
    "aggregation": "event_time_and_exposure_cohort",
    "two_way_fixed_effects_event_study_primary": false,
    "anticipation_periods": 2,
    "minimum_pre_treatment_quarters": 8,
    "minimum_post_treatment_quarters": 4,
    "minimum_treated_regions": 2,
    "minimum_control_regions_per_cohort": 3,
    "minimum_asset_classes": 2,
    "leave_one_region_out_required": true,
    "leave_one_event_out_required": true,
    "negative_control_outcome_required": true,
    "placebo_event_dates_required": true,
    "pretrend_equivalence_assessment_required": true,
    "covariates_locked_before_outcome_analysis": true
  },
  "treatment": {
    "primary_quantity": "realized_ai_infrastructure_construction_activity",
    "authorizing_measures": [
      "realized_construction_spend_cad",
      "data_centre_construction_labour_hours"
    ],
    "proxy_measures_research_only": [
      "permitted_construction_value_cad",
      "energized_data_centre_load_mw"
    ],
    "prohibited_as_treatment": [
      "announced_capex_cad",
      "requested_connection_load_mw",
      "forecast_data_centre_demand_mw",
      "scenario_capex_cad",
      "graph_pressure_score"
    ],
    "onset_rule": "First quarter in which an authorizing realized construction measure is positive after source and geography reconciliation.",
    "dose_rule": "Quarterly authorizing quantity in its published physical or currency unit; no conversion from announcements or graph scores."
  },
  "outcomes": [
    {
      "outcome_id": "PUBLIC_PROJECT_COST_CHANGE",
