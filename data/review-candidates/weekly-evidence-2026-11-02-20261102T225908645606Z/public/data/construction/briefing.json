          "Concentrated site labour",
          "Evaluate prefabrication and planned package sequencing",
          "Earlier coordination, transport and installation interfaces"
        ],
        [
          "Specialist recruitment pressure",
          "Engage trade contractors and training partners early",
          "Allow time for qualifications and supervisory capacity"
        ],
        [
          "Competing capital schedules",
          "Coordinate procurement and commissioning windows",
          "Protect critical milestones across affected projects"
        ]
